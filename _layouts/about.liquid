---
layout: default
---
{%- comment -%}
  Site override of al_folio_core's about layout. Same ingredients as al-folio
  (bio, profile picture, projects, selected papers, latest posts, socials),
  arranged as numbered sections, with a short `journey` in place of the full CV.
{%- endcomment -%}
{% assign section = 0 %}

<section class="site-hero home-hero">
  <p class="home-hero__role"><span class="home-hero__pulse" aria-hidden="true"></span>{{ page.subtitle }}</p>
  <h1 class="site-display">{{ page.headline | default: site.first_name }}<span class="dot">.</span></h1>
  {% if page.intro %}<p class="site-lede">{{ page.intro }}</p>{% endif %}
  <div class="site-actions">
    <a class="site-btn" href="{{ '/blog/' | relative_url }}">Read the blog &rarr;</a>
    <a class="site-btn site-btn--ghost" href="{{ '/contact/' | relative_url }}">Get in touch</a>
  </div>
</section>

<!-- Bio -->
{% assign section = section | plus: 1 %}
<section class="site-section" id="about">
  <div class="site-section__head">
    <span class="site-index">0{{ section }}</span>
    <h2>About</h2>
  </div>
  <div class="home-bio">
    <div class="home-bio__text">{{ content }}</div>
    {% if page.profile.image %}
      <div class="home-portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        <div class="home-portrait__frame">
          {% include figure.liquid loading="eager" path=profile_image_path alt="Portrait of Yasser Khalafaoui" sizes="(min-width: 768px) 20rem, 90vw" cache_bust=true %}
        </div>
        {% if page.profile.caption %}<p class="home-portrait__caption">{{ page.profile.caption }}</p>{% endif %}
      </div>
    {% endif %}
  </div>
</section>

<!-- Focus areas -->
{% if page.focus %}
  {% assign section = section | plus: 1 %}
  <section class="site-section" id="focus">
    <div class="site-section__head">
      <span class="site-index">0{{ section }}</span>
      <h2>What I work on</h2>
    </div>
    <div class="home-facts">
      {% for f in page.focus %}
        <div>
          <p class="home-facts__label">[{{ f.label }}]</p>
          <h3>{{ f.title }}</h3>
          <p>{{ f.text }}</p>
        </div>
      {% endfor %}
    </div>
  </section>
{% endif %}

<!-- Latest writing -->
{% if page.latest_posts and site.posts.size > 0 %}
  {% assign section = section | plus: 1 %}
  {% assign all_series = site.series | sort: 'order' %}
  {% assign standalone = site.posts | where_exp: 'p', 'p.series == nil' %}
  <section class="site-section" id="writing">
    <div class="site-section__head">
      <span class="site-index">0{{ section }}</span>
      <h2>Latest writing</h2>
      <a class="site-link-arrow site-section__more" href="{{ '/blog/' | relative_url }}">all posts &rarr;</a>
    </div>
    {% for s in all_series limit: 1 %}
      {% include site/series_card.liquid series=s index=forloop.index %}
    {% endfor %}
    {% if standalone.size > 0 %}
      <ul class="post-rows" style="margin-top: 2rem">
        {% for p in standalone limit: 3 %}
          {% include site/post_row.liquid post=p %}
        {% endfor %}
      </ul>
    {% endif %}
  </section>
{% endif %}

<!-- Path: one card per chapter (front matter `journey`) instead of a full CV -->
{% if page.journey %}
  {% assign section = section | plus: 1 %}
  <section class="site-section" id="path">
    <div class="site-section__head">
      <span class="site-index">0{{ section }}</span>
      <h2>The path so far</h2>
      <p>{{ page.journey_note | default: 'Industry, research and teaching, one chapter each.' | markdownify | remove: '<p>' | remove: '</p>' | strip }}</p>
    </div>
    <ol class="path-grid">
      {% for c in page.journey %}
        <li class="path-card">
          <div class="path-card__top">
            <span class="path-card__n" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="path-card__label">{{ c.label }}</span>
            {% if c.when %}<span class="path-card__when">{{ c.when }}</span>{% endif %}
          </div>
          <h3>{{ c.title }}</h3>
          <p>{{ c.text }}</p>
          {% if c.tags or c.link %}
            <div class="path-card__foot">
              {% for t in c.tags %}<span class="site-chip">{{ t }}</span>{% endfor %}
              {% if c.link %}<a class="site-link-arrow" href="{{ c.link }}">{{ c.link_label | default: 'more' }} &rarr;</a>{% endif %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </section>
{% endif %}

<!-- Projects -->
{% assign projects = site.projects | sort: 'importance' %}
{% if page.projects != false and projects.size > 0 %}
  {% assign section = section | plus: 1 %}
  <section class="site-section" id="projects">
    <div class="site-section__head">
      <span class="site-index">0{{ section }}</span>
      <h2>Selected projects</h2>
      <p>Applied work, from AI mentoring to emotion recognition.</p>
    </div>
    <div class="work-grid">
      {% for project in projects %}
        <a class="work-card" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
          {% if project.img %}
            <div class="work-card__media"><img src="{{ project.img | relative_url }}" alt="" loading="lazy"></div>
          {% endif %}
          <span class="site-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ project.title }}</h3>
          <p>{{ project.description }}</p>
          <span class="site-link-arrow">read the write-up &rarr;</span>
        </a>
      {% endfor %}
    </div>
  </section>
{% endif %}

<!-- Selected papers -->
{% if page.selected_papers %}
  {% assign section = section | plus: 1 %}
  <section class="site-section home-pubs" id="publications">
    <div class="site-section__head">
      <span class="site-index">0{{ section }}</span>
      <h2>Selected publications</h2>
    </div>
    {% include selected_papers.liquid %}
  </section>
{% endif %}
